        {
          "name": "Login User/Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (response.token) {",
                  "  // Handles both response.user.role AND response.role",
                  "  const userRole = response.user?.role || response.role;",
                  "",
                  "  if (userRole === \"admin\") {",
                  "    pm.collectionVariables.set(\"adminToken\", response.token);",
                  "    console.log(\"Admin Token Saved Successfully!\");",
                  "  } else {",
                  "    pm.collectionVariables.set(\"providerToken\", response.token);",
                  "    console.log(\"Provider Token Saved Successfully!\");",
                  "  }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "// { \n//     \"email\": \"cartikeya.official@gmail.com\", \n//     \"password\": \"1234567890\"\n// }\n{ \n    \"email\": \"cartikeya@gmail.com\", \n    \"password\": \"1234567890\"\n}\n",
              "options": {
